# Copie este arquivo para ".env" (uso local com o emulador) e preencha os valores.
# Em produção, NÃO suba .env — use segredos do Firebase:
#   firebase functions:secrets:set META_VERIFY_TOKEN
#   firebase functions:secrets:set META_APP_SECRET
#   firebase functions:secrets:set N8N_WEBHOOK_URL
#   firebase functions:secrets:set N8N_WEBHOOK_SECRET

# Token que você mesmo inventa e cadastra também no painel da Meta
# (App do WhatsApp > Configuração > Webhooks > "Verify token").
META_VERIFY_TOKEN=

# "App Secret" do app da Meta (Configurações do app > Básico).
# Usado para validar a assinatura (x-hub-signature-256) de cada requisição recebida.
META_APP_SECRET=

# URL de produção do webhook do fluxo "whatsapp-atendimento" no n8n.
N8N_WEBHOOK_URL=https://SEU-N8N.dominio.com/webhook/whatsapp-atendimento

# Segredo compartilhado só entre esta function e o n8n (cabeçalho x-rd-webhook-secret),
# pra provar pro n8n que a chamada veio daqui e não de qualquer lugar.
N8N_WEBHOOK_SECRET=
