rules_version = '2';

// Regras pensadas para o momento atual: a Cloud Function (webhookWhatsApp)
// usa o Admin SDK e o n8n usa uma conta de serviço com IAM — nenhum dos
// dois passa por estas regras, elas só valem para acesso vindo do
// navegador (SDK cliente do Firebase), como o futuro painel administrativo.
//
// Padrão adotado: cada usuário autenticado tem uma custom claim
// "empresaId" (definida pelo backend ao criar o login do dono do salão)
// que só deixa ele enxergar os dados da própria empresa.
service cloud.firestore {
  match /databases/{database}/documents {

    match /empresas/{empresaId} {
      allow read, write: if request.auth != null
                          && request.auth.token.empresaId == empresaId;

      match /servicos/{servicoId} {
        // Catálogo de serviços pode ser público (ex: consultado pelo site do salão).
        allow read: if true;
        allow write: if request.auth != null
                     && request.auth.token.empresaId == empresaId;
      }

      match /clientes/{telefone} {
        allow read, write: if request.auth != null
                            && request.auth.token.empresaId == empresaId;

        match /mensagens/{mensagemId} {
          allow read, write: if request.auth != null
                              && request.auth.token.empresaId == empresaId;
        }
      }
    }

    // Só a Cloud Function (Admin SDK, ignora estas regras) escreve aqui.
    match /webhooks_nao_identificados/{id} {
      allow read, write: if false;
    }
  }
}
